# Copy this file to .env and fill in the values. On Vercel, add the same keys under Project > Settings > Environment Variables.
PORT=4000
MONGODB_STRING=mongodb+srv://<user>:<password>@<cluster>/patient-summaries
JWT_SECRET_KEY=<any long random string>

# Firebase (Google sign-in). From Firebase console > Project settings > Your apps > Web app config.
# Leave these empty to hide the "Continue with Google" button.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
